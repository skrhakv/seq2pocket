# Reproduces the "SAS points on predicted residues" SI figure (1BYG chain A,
# human C-terminal Src kinase, Staurosporine site) with the real SAS points
# (same probe_radius=1.6, n_points=50 as
# clustering_utils.py), not PyMOL's own dot-solvent surface, and no water
# contamination (this repo's SASA pipeline strips non-standard residues
# before computing anything). 788 points on 51
# predicted residues, colored as a single pocket (not per-cluster).
#
# Usage:
#   pymol 1byg_sas_points_figure.pml

reinitialize
fetch 1byg, async=0
remove not chain A
remove solvent
hide everything

bg_color white
set two_sided_lighting, on
show surface, polymer
color grey80, polymer

select predicted_pocket, resi 201+202+203+204+205+206+207+208+209+210+211+219+220+221+222+232+233+236+237+239+240+243+248+249+250+251+264+266+267+268+269+270+271+272+273+276+305+310+312+314+318+319+320+321+322+330+331+332+333+334+335
color skyblue, predicted_pocket

# Staurosporine (resn STU) - the bound inhibitor, kept and shown explicitly
select ligand, resn STU
show sticks, ligand
color magenta, ligand
util.cnc ligand

python
